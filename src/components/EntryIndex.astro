---
import type { Entry } from '../lib/entries';
import { ENTRY_KINDS, collectTags, countLabel, entryPath, formatMonthYear, sourceNameFor, type EntryKind } from '../lib/writing';

interface Props {
  kind: EntryKind;
  entries: Entry[];
}

const { kind, entries } = Astro.props;
const { allLabel, noun } = ENTRY_KINDS[kind];
const tags = collectTags(entries.map((entry) => entry.data.tags));
---

{
  tags.length > 0 && (
    <div class="filters">
      <button class="chip chip-all" type="button" data-tag-filter="" aria-pressed="true" aria-label={allLabel} title={allLabel}>
        ∞
      </button>
      {tags.map((tag) => (
        <button class="chip" type="button" data-tag-filter={tag} aria-pressed="false">
          {tag}
        </button>
      ))}
    </div>
  )
}
{
  entries.map(({ id, data }) => (
    <a class="entry hairline-top" href={entryPath(kind, id)} data-entry data-tags={JSON.stringify(data.tags)}>
      <time class="entry-date" datetime={data.date.toISOString()}>
        {formatMonthYear(data.date)}
      </time>
      <div class="entry-body">
        <h2>{data.title}</h2>
        <p class="entry-summary">{data.summary}</p>
        <div class="entry-tags">
          {data.tags.map((tag) => <span class="chip">{tag}</span>)}
          {data.sourceUrl && <span class="entry-source">↗ {sourceNameFor(data.sourceUrl, data.sourceName)}</span>}
        </div>
      </div>
    </a>
  ))
}
<div class="count hairline-top" data-entry-count data-noun={noun} aria-live="polite">{countLabel(entries.length, noun)}</div>

<script>
  import '../scripts/tag-filter';
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 24px;
  }

  .entry {
    display: flex;
    flex-wrap: wrap;
    gap: 2px clamp(14px, 3vw, 40px);
    margin: 0 -16px;
    padding: 20px 16px;
    border-radius: 10px;
    color: var(--ink);
  }

  .entry:hover {
    background-color: var(--surface-hover);
    color: var(--ink);
  }

  .entry[hidden] {
    display: none;
  }

  .entry-date {
    flex: 0 0 7.5em;
    margin-top: 4px;
    font-size: 12.5px;
    letter-spacing: 0.01em;
    color: var(--muted);
  }

  .entry-body {
    flex: 1 1 18em;
    min-width: 0;
  }

  h2 {
    margin: 0 0 7px;
    font-size: clamp(19px, 2.2vw, 25px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.024em;
  }

  .entry-summary {
    max-width: 58ch;
    margin: 0 0 11px;
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--subtle);
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
  }

  .entry-source {
    font-size: 11.5px;
    letter-spacing: 0.01em;
    color: var(--link);
  }

  .count {
    padding-top: 18px;
    font-size: 12px;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
</style>
