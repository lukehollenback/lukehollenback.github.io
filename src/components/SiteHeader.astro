---
import { NAV_ITEMS, SITE } from '../data/site';

const path = Astro.url.pathname.replace(/\.html$/, '');
const isCurrentSection = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <a class="wordmark" href="/">{SITE.name}</a>
  <nav class="site-nav" aria-label="Primary">
    {
      NAV_ITEMS.map((item) => (
        <a class="nav-link hit-area" href={item.href} aria-current={isCurrentSection(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
    <button class="theme-toggle hit-area" type="button" data-theme-toggle hidden>
      <span data-icon="moon">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 14.500A8.500 8.500 0 0 1 9.500 4 8.500 8.500 0 1 0 20 14.500z" />
        </svg>
      </span>
      <span data-icon="sun" hidden>
        <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.500v2.500M12 19v2.500M2.500 12H5M19 12h2.500M5.300 5.300 7 7M17 17l1.700 1.700M18.700 5.300 17 7M7 17l-1.700 1.700" />
        </svg>
      </span>
    </button>
  </nav>
</header>

<script>
  import '../scripts/theme-toggle';
</script>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: clamp(15px, 3vh, 22px) var(--shell-pad) 0;
  }

  .wordmark {
    font-size: 19px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .wordmark:hover {
    color: var(--link);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(14px, 2.4vw, 30px);
    font-size: 13.5px;
    letter-spacing: 0.04em;
  }

  .nav-link {
    padding-bottom: 3px;
    border-bottom: 1px solid transparent;
    color: var(--subtle);
  }

  .nav-link:hover {
    border-bottom-color: var(--link);
    color: var(--link);
  }

  .nav-link[aria-current='page'] {
    color: var(--ink);
  }

  .theme-toggle {
    padding: 0;
    border: none;
    background: transparent;
    line-height: 1;
    color: var(--muted);
    cursor: pointer;
    /* Link boxes extend 4px below their text for the underline, so centering on them sits the icon low. */
    margin-bottom: 4px;
  }

  /* Below this width the nav wraps under the wordmark; it then spans the row with the toggle at the far edge. */
  @media (width < 480px) {
    .site-nav {
      flex-basis: 100%;
    }

    .theme-toggle {
      margin-left: auto;
    }
  }

  .theme-toggle svg {
    display: block;
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.800;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-toggle span {
    display: block;
  }

  .theme-toggle span[hidden] {
    display: none;
  }

  .theme-toggle:hover {
    color: var(--link);
  }
</style>
