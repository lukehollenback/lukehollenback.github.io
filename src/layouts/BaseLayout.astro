---
import '../styles/global.css';
import primaryFontUrl from '@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE, absoluteUrl } from '../data/site';
import { siteGraph, type JsonLdNode } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  /** Overrides the page's own URL, for content whose original lives elsewhere. */
  canonicalUrl?: string;
  publishedTime?: Date;
  /** Nodes for this page, added to the graph beside the site-wide person and website. */
  structuredData?: JsonLdNode[];
  /** Path to this page's content as Markdown, when it has one. */
  markdownPath?: string;
  noindex?: boolean;
}

const { title, description, canonicalUrl, publishedTime, structuredData = [], markdownPath, noindex = false } = Astro.props;

// build.format 'file' puts '.html' on Astro.url; the public URL has none.
const pagePath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/');
const canonical = canonicalUrl ?? absoluteUrl(pagePath);
const shareImageAlt = `${SITE.name}. ${SITE.statement}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta http-equiv="content-language" content="en-US" />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" as="font" type="font/woff2" href={primaryFontUrl} crossorigin />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={publishedTime ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={absoluteUrl(SITE.shareImage.path)} />
    <meta property="og:image:width" content={String(SITE.shareImage.width)} />
    <meta property="og:image:height" content={String(SITE.shareImage.height)} />
    <meta property="og:image:alt" content={shareImageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(SITE.shareImage.path)} />
    <meta name="twitter:image:alt" content={shareImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(siteGraph(structuredData))} />

    <!-- Inline so a pinned theme applies before first paint. Key must match THEME_STORAGE_KEY. -->
    <script is:inline>
      try {
        const stored = localStorage.getItem('lh-theme');
        if (stored === 'light' || stored === 'dark') document.documentElement.dataset.theme = stored;
      } catch {
        // Storage is blocked: fall through to the system preference.
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <slot />
    <SiteFooter />
  </body>
</html>
