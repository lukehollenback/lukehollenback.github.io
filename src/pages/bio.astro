---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BIO_HEADING, BIO_PARAGRAPHS, PATENTS, TIMELINE } from '../data/bio';
import { breadcrumbNode, profilePageNode } from '../lib/structured-data';

const title = 'About Luke Hollenback — Product & Engineering Leader, Denver';
const description =
  'From embedded avionics to running product development at Nextworld: twelve years of engineering and product leadership, a no-code platform, an AI-native evolution, and three patent filings.';
---

<BaseLayout
  title={title}
  description={description}
  structuredData={[profilePageNode('/bio', title, description), breadcrumbNode([{ name: 'Bio', path: '/bio' }])]}
>
  <main id="main" class="page">
    <div class="bio-inner split">
      <div>
        <h1 class="page-title">{BIO_HEADING}</h1>
        <div class="story">
          {
            BIO_PARAGRAPHS.map((segments) => (
              <p>
                {segments.map((segment) =>
                  typeof segment === 'string' ? segment : <span class="highlight">{segment.highlight}</span>,
                )}
              </p>
            ))
          }
        </div>
      </div>
      <aside>
        <p class="eyebrow aside-label">Résumé</p>
        {
          TIMELINE.map((job) => (
            <div class="job hairline-top">
              <p class="job-years">{job.years}</p>
              <p class="job-role">{job.role}</p>
              <p class="job-org">{job.org}</p>
            </div>
          ))
        }
        <div class="patents hairline-top">
          <p class="eyebrow aside-label">Patent Filings</p>
          {
            PATENTS.map((patent) => (
              <a class="patent" href={patent.href} target="_blank" rel="noopener">
                {patent.title}
                <span class="patent-number">{patent.number}</span>
              </a>
            ))
          }
        </div>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .bio-inner {
    --split-min: 320px;
    max-width: 1120px;
    margin: 0 auto;
    gap: clamp(32px, 6vw, 88px);
  }

  .page-title {
    max-width: 24ch;
    margin-bottom: 28px;
  }

  .story {
    max-width: 60ch;
    font-size: 16px;
    line-height: 1.68;
    color: var(--body);
  }

  .story p {
    margin: 0 0 18px;
  }

  .story p:last-child {
    margin-bottom: 0;
  }

  .aside-label {
    margin-bottom: 10px;
    font-size: 12.5px;
  }

  .job {
    padding: 15px 0 14px;
  }

  .job-years {
    margin: 0 0 5px;
    font-size: 12px;
    letter-spacing: 0.01em;
    color: var(--muted);
  }

  .job-role {
    margin: 0 0 3px;
    font-size: 19px;
    letter-spacing: -0.02em;
  }

  .job-org {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--muted);
  }

  .patents {
    margin-top: 2px;
    padding-top: 16px;
  }

  .patent {
    display: block;
    margin-bottom: 9px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--body);
  }

  .patent:hover {
    color: var(--link);
  }

  .patent-number {
    display: block;
    font-size: 12.5px;
    color: var(--muted);
  }
</style>
