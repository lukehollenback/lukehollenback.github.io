---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SERVICES } from '../data/services';
---

<BaseLayout
  title="Luke Hollenback — Product, engineering, and AI advisory"
  description="Luke Hollenback is Vice President of Product Development at Nextworld and an independent advisor to founders on product strategy, architecture, and AI initiatives. Twelve years building enterprise software; three patent filings."
>
  <main id="main" class="home">
    <div class="home-inner split">
      <div>
        <p class="availability">Independent product, engineering, and AI advisory.</p>
        <h1>I've shipped enough to know what to cut.</h1>
        <p class="lede">
          Twelve years building hard software that powers real businesses. I now run product development for an
          enterprise AI platform. Multiple patents filed, countless products shipped, and an addiction to simplicity.
        </p>
        <div class="actions">
          <a class="button" href="/contact">Start a Conversation <span class="button-arrow">→</span></a>
          <a class="quiet-link" href="/bio">Check my Experience</a>
        </div>
      </div>
      <div class="hairline-top">
        {
          SERVICES.map((service) => (
            <a class="service hairline-bottom" href="/services">
              <span class="service-name">{service.name}</span>
              <span class="service-tagline">{service.tagline}</span>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .home {
    flex: 1;
    display: flex;
    align-items: center;
    padding: clamp(18px, 4vh, 56px) var(--shell-pad);
  }

  .home-inner {
    --split-min: 340px;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    gap: clamp(20px, 5vw, 72px);
    align-items: end;
  }

  .availability {
    margin: 0 0 clamp(10px, 3vh, 26px);
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--link);
  }

  h1 {
    max-width: 13.5em;
    margin: 0 0 clamp(10px, 2.2vh, 24px);
    font-size: clamp(30px, min(5.6vw, 7.2vh), 74px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.032em;
  }

  .lede {
    max-width: 44ch;
    margin: 0 0 clamp(14px, 3.2vh, 34px);
    font-size: clamp(13.5px, min(1.5vw, 2.5vh), 18px);
    line-height: 1.5;
    color: var(--body-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }

  .service {
    display: block;
    padding: clamp(9px, 1.4vh, 13px) 0;
    color: var(--ink);
  }

  .service:hover {
    color: var(--link);
  }

  .service-name {
    font-size: clamp(15.5px, min(1.9vw, 2.9vh), 22px);
    letter-spacing: -0.02em;
  }

  .service-tagline {
    display: block;
    margin-top: 3px;
    font-size: 12.5px;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
</style>
